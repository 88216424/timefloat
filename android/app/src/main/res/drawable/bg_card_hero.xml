<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面顶部 Hero 卡：深色渐变 + 橙色描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF1E2531"
                android:centerColor="#FF151922"
                android:endColor="#FF0E1116" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#1AFF6A00"
                android:endColor="#00FF6A00" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#40FF6A00" />
        </shape>
    </item>
</layer-list>
